<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed for local dev (LAN IP + HTTP backend).
     For Play Store release with HTTPS only, set cleartextTrafficPermitted="false"
     or remove this file and set android:usesCleartextTraffic="false" on <application>. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
