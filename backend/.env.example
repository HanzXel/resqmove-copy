# ResQMove Backend — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The backend loads it automatically if you add `require('dotenv').config()`
# at the top of server.js — OR just set these as PowerShell env vars before
# running `node server.js` (see SETUP.md).
#
# PowerShell one-liner (paste into terminal before `node server.js`):
#   $env:JWT_SECRET="resqmove-super-secret-key-change-in-prod-2024"; $env:NODE_ENV="development"

# ── Required ────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Change this for production.
JWT_SECRET=resqmove-super-secret-key-change-in-prod-2024

# ── Optional ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
